  {
   "id": "el-002",
   "tipo": "multipla",
   "dificuldade": "facil",
   "topico": "trifasico",
   "enunciado": "<p>Em ligação triângulo, a corrente de linha é:</p>",
   "alternativas": [
    "igual à corrente de fase",
