  {
   "id": "el-003",
   "tipo": "calculo",
   "dificuldade": "medio",
   "topico": "trifasico",
   "enunciado": "<p>Um motor em 380 V, com 30 A e fator de potência 0,85, consome potência ativa de aproximadamente:</p>",
   "alternativas": [
    "9,7 kW",
    "16,8 kW",
    "19,7 kW",
    "29,1 kW"
   ],
   "correta": 1,
   "formulas": [
    "P = √3 V I cos φ"
   ],
   "explicacao": "<div class=\"passo\">√3·380·30·0,85 = <strong>16,8 kW</strong></div><p>19,7 é a potência aparente em kVA.</p>"
  },
  {
   "id": "el-004",
   "tipo": "calculo",
   "dificuldade": "facil",
   "topico": "trifasico",
   "enunciado": "<p>A tensão de fase em uma rede de 380 V de linha é:</p>",
   "alternativas": [
    "380 V",
    "219 V",
