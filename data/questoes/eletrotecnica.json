   "id": "el-001",
   "tipo": "multipla",
   "dificuldade": "facil",
   "topico": "trifasico",
   "enunciado": "<p>Em ligação estrela equilibrada, a tensão de linha é:</p>",
   "alternativas": [
    "igual à tensão de fase",
    "3 vezes a tensão de fase",
    "metade da tensão de fase",
    "√3 vezes a tensão de fase"
