    "2,00",
    "0,37",
    "1,26",
    "1,63"
   ],
   "correta": 3,
   "formulas": [
    "L{y′} = sY − y(0)"
   ],
   "explicacao": "<div class=\"passo\">y(t) = 2 − e<sup>−4t</sup></div><div class=\"passo\">y(0,25) = 2 − e<sup>−1</sup> = <strong>1,63</strong></div>"
  },
  {
