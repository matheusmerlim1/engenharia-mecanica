   "id": "us-022",
   "tipo": "multipla",
   "dificuldade": "dificil",
   "topico": "ferramentas",
   "enunciado": "<p>Em fresamento com metal duro, aplicar fluido em abundância pode:</p>",
   "alternativas": [
    "eliminar o desgaste",
