   "enunciado": "<p>Ensaios deram 10 min a 200 m/min e 40 min a 150 m/min. O expoente de Taylor é:</p>",
   "alternativas": [
    "0,250",
    "0,208",
    "0,125",
    "0,750"
   ],
   "correta": 1,
   "formulas": [
    "n = ln(v₁/v₂)/ln(T₂/T₁)"
   ],
   "explicacao": "<div class=\"passo\">n = ln(200/150)/ln(40/10) = <strong>0,208</strong></div>"
  },
  {
   "id": "us-026",
   "tipo": "multipla",
   "dificuldade": "facil",
   "topico": "taylor",
   "enunciado": "<p>O desgaste de flanco é causado principalmente por:</p>",
   "alternativas": [
