  {
   "id": "us-023",
   "tipo": "calculo",
   "dificuldade": "facil",
   "topico": "taylor",
   "enunciado": "<p>Na equação v T<sup>n</sup> = C, com n = 0,25, C = 200 e v = 100 m/min, a vida é:</p>",
   "alternativas": [
    "2 min",
    "4 min",
    "16 min",
    "400 min"
   ],
   "correta": 2,
   "formulas": [
