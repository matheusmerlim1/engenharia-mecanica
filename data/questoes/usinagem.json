  {
   "id": "us-021",
   "tipo": "multipla",
   "dificuldade": "medio",
   "topico": "ferramentas",
   "enunciado": "<p>Na classificação ISO 513, o grupo K é indicado para:</p>",
   "alternativas": [
    "ferros fundidos",
