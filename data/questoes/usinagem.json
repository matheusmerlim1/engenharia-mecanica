   ],
   "explicacao": "<div class=\"passo\">T = (200/100)<sup>4</sup> = <strong>16 min</strong></div>"
  },
  {
   "id": "us-024",
   "tipo": "calculo",
   "dificuldade": "medio",
   "topico": "taylor",
   "enunciado": "<p>Com n = 0,25, ao dobrar a velocidade de corte, a vida fica dividida por:</p>",
   "alternativas": [
    "2",
    "4",
    "16",
    "8"
   ],
   "correta": 2,
   "formulas": [
