   ],
   "correta": 3,
   "formulas": [
    "k_s = k_{s1} h^{−m_c}"
   ],
   "explicacao": "<div class=\"passo\">1700·0,25<sup>−0,25</sup> = 1700·1,414 = <strong>2404 MPa</strong></div>"
  },
  {
   "id": "us-018",
   "tipo": "multipla",
   "dificuldade": "facil",
   "topico": "ferramentas",
   "enunciado": "<p>A ordem crescente de velocidade de corte admissível entre as ferramentas abaixo é:</p>",
   "alternativas": [
